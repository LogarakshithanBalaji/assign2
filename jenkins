pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scmGit(branches: [[name: '*/main']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/LogarakshithanBalaji/assign2.git']])
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'pip install --upgrade pip'
                sh 'pip install pytest'
            }
        }

        stage('Run Unit Tests') {
            steps {
                sh 'python3 -m pytest -v'
            }
        }
    }
}
